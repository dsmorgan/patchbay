# patchbay configuration — copy to .env and fill in what you have.
#
#   cp .env.example data/.env        # containerized (see docker-compose.example.yml)
#   cp .env.example .env             # running from a checkout
#
# NOTHING here is required, and everything is commented out. UNCOMMENT the
# block for each tool you actually run and fill in its values. A collector
# activates only when its variables are set and is skipped otherwise, so
# start with the one or two tools you already have — LibreNMS alone gets you
# most of the topology — and add the rest later. Copied as-is and left
# unedited, this file configures nothing and patchbay says so on its
# dashboard rather than failing against example.internal hostnames.
# Every knob is documented in docs/configuration.md.
#
# Keep the real .env out of version control: it holds credentials, and the
# declarations at the bottom describe your physical network.

# --- data sources ------------------------------------------------------------
# Each block is independent — uncomment the ones you run.

# LibreNMS — device and port inventory, LLDP neighbors, MAC tables, traffic
# graphs. The single most useful source: topology is largely built from it.
# Token: LibreNMS UI -> Settings -> API -> API Settings.
#LIBRENMS_URL=http://librenms.example.internal:8000
#LIBRENMS_TOKEN=

# Oxidized — device config backups, for the config timeline, diffs, and
# per-port VLAN membership. Point at its REST API.
#OXIDIZED_URL=http://oxidized.example.internal:8888

# phpIPAM — subnets, VLANs, and the address book the drift report compares
# live ARP and DHCP against.
#IPAM_URL=https://ipam.example.internal/api
#IPAM_APP_ID=patchbay
#IPAM_TOKEN=

# UniFi Network application — access points and their wireless clients.
# A local read-only admin account; self-hosted controllers use cookie auth.
#UNIFI_URL=https://unifi.example.internal:8443
#UNIFI_USER=
#UNIFI_PASS=

# OPNsense — firewall interfaces, gateways, routes, ARP, and DHCP leases.
# API key/secret: System -> Access -> Users -> edit user -> API keys.
# The routing views also need the "Diagnostics: Routing Tables" privilege.
#OPNSENSE_HOST=firewall.example.internal
#OPNSENSE_API_KEY=
#OPNSENSE_API_SECRET=

# pfSense — firewall interfaces, gateway health, and DHCP static mappings.
# Requires the pfSense REST API package (pfrest): System -> REST API -> Keys.
# When you create a key, copy the value shown — pfSense will not display it again.
# PFSENSE_API_KEY is not sent in requests; leave blank or set to the username.
#PFSENSE_HOST=https://firewall.example.internal
#PFSENSE_API_KEY=
#PFSENSE_API_SECRET=

# vSphere/vCenter — hypervisors, VMs and their placement, physical NIC
# CDP/LLDP hints, and the port group VLAN of every virtual NIC (which no
# guest OS can see for itself).
#VSPHERE_HOST=vcenter.example.internal
#VSPHERE_USER=patchbay@vsphere.local
#VSPHERE_PASS=

# --- serving patchbay --------------------------------------------------------

# Outbound TLS verification for the API calls above: 1 (default), 0, or a path
# to a CA bundle. Prefer a bundle over 0 — see docs/configuration.md.
#PATCHBAY_TLS_VERIFY=1
# Per-source override, for the common case of a vCenter still serving its
# self-signed VMCA certificate while everything else is properly signed.
#VSPHERE_TLS_VERIFY=0

# Serving the UI over HTTPS: off (default, plain HTTP or a proxy in front)
# or direct, which serves from these PEM files and picks up renewals without
# a restart — any ACME client that drops files works.
#PATCHBAY_TLS=direct
#PATCHBAY_TLS_CERT=/data/tls/patchbay.crt
#PATCHBAY_TLS_KEY=/data/tls/patchbay.key

# Access control: none (default), password, or oidc. patchbay is a gate, not
# an identity system — there are no user accounts. Generate the hash with
# `patchbay hash-password`.
#PATCHBAY_AUTH=password
#PATCHBAY_PASSWORD_HASH=
# OIDC against any provider: see docs/configuration.md for the full set.
#PATCHBAY_OIDC_CLIENT_ID=
#PATCHBAY_OIDC_CLIENT_SECRET=
#PATCHBAY_OIDC_AUTH_URL=
#PATCHBAY_OIDC_TOKEN_URL=
#PATCHBAY_OIDC_ALLOWED=you@example.com

# Self-contained HTML snapshots, readable with the network down — the point
# being to still have the map when the map is what you need.
#PATCHBAY_SNAPSHOT_DIR=/data/snapshots
#PATCHBAY_SNAPSHOT_KEEP=30
#PATCHBAY_SNAPSHOT_AT=03:30
#PATCHBAY_SNAPSHOT_DELIVER_DIR=/mnt/offsite

# --- operator declarations ---------------------------------------------------
# Facts no protocol can report. All optional, all editable from the ops page
# when they are NOT set here (the env file always wins). Ports are written
# device:interface throughout. Examples below are illustrative — delete them.

# Identity: map a chassis serial or an FQDN some source reports onto the
# canonical device name, so one box stops appearing as two.
#PATCHBAY_ALIASES=ABC123456=core1,core1.example.internal=core1

# Cabling nothing can discover: a port to a dumb device, a quiet bond member,
# or a mirror destination. The far side may be a bare name when its own port
# is unknowable. Removing an entry removes the link.
#PATCHBAY_LINKS=core1:1/0/3=hyp1:vmnic6,sw1:e1/1/24=basement-tv

# Ports you know feed an unmanaged switch, shown even when too few MACs are
# live for patchbay to infer one.
#PATCHBAY_UNMANAGED=core1:1/0/8,sw1:e1/1/5

# Internet providers and where each physically lands. Both accept lists: one
# name with several ports is redundant circuits to one provider.
#PATCHBAY_WAN_NAME=Example Fiber
#PATCHBAY_WAN_PORT=core1:1/0/16

# Out-of-band ties — a BMC/iDRAC/CIMC and the server it manages.
#PATCHBAY_RELATED=bmc1=hyp1

# Trunks with a restricted VLAN list. Trunks are otherwise assumed to carry
# every VLAN, since allowed-lists aren't readable over SNMP.
#PATCHBAY_VLAN_FILTER=core1:1/0/11=1+24+73

# Real service capacity where it is below the port speed — a 10G port
# carrying a 3G circuit. Load math divides by this; the map shows "10G (3G)".
#PATCHBAY_CAPACITY=core1:1/0/16=3G

# Patch panels, as name:size=regex. The regex's first capture group is the
# panel position a port description claims. Size 0 sizes by the highest seen.
#PATCHBAY_PANELS=Basement:12=\[(\d+)\]

# --- misc --------------------------------------------------------------------
# Where the SQLite model lives. The container image already sets this, and a
# value already in the environment wins over this file, so uncomment it only
# when you run patchbay from a checkout and want the DB somewhere specific.
#PATCHBAY_DB=/data/patchbay.db
#
# The poll interval belongs to docker compose, not here: it substitutes
# ${PATCHBAY_POLL_INTERVAL} from your shell or from a .env sitting next to the
# compose file, and never reads this one. Set it there, or edit the poller's
# sleep in docker-compose.example.yml. The default is 300 seconds.
